{
  "name": "ktv-reservation-system",
  "version": "0.1.0",
  "private": true,
  "description": "KTV & Entertainment Club Reservation System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-super-admin.ts",
    "test:phase1": "node --env-file=.env.local scripts/test-phase1.mjs",
    "db:up": "bash scripts/dev-mongodb.sh start && node scripts/init-replset.mjs",
    "db:down": "bash scripts/dev-mongodb.sh stop",
    "db:status": "bash scripts/dev-mongodb.sh status",
    "test:ui": "node --env-file=.env.local scripts/ui-shot.mjs",
    "test:ui:full": "node --env-file=.env.local scripts/ui-check.mjs",
    "seed:rooms": "tsx --env-file=.env.local scripts/seed-demo-rooms.ts",
    "seed": "npm run seed:admin && npm run seed:rooms",
    "test:phase2": "node --env-file=.env.local scripts/test-phase2.mjs",
    "test:ui:phase2": "node --env-file=.env.local scripts/ui-phase2.mjs",
    "test:phase3": "node --env-file=.env.local scripts/test-phase3.mjs",
    "test:ui:phase3": "node --env-file=.env.local scripts/ui-phase3.mjs",
    "db:indexes": "tsx --env-file=.env.local scripts/sync-indexes.ts",
    "test:phase4": "tsx --env-file=.env.local scripts/test-phase4.ts",
    "test:notifications": "tsx --env-file=.env.local scripts/test-notifications.ts",
    "test:query-plans": "tsx --env-file=.env.local scripts/test-query-plan.ts",
    "deploy:preflight": "node scripts/deployment-preflight.mjs",
    "deploy:smoke": "node scripts/deployment-smoke.mjs",
    "rebrand:publiq": "tsx --env-file=.env.local scripts/rebrand-publiq.ts",
    "test:ui:login-cooldown": "node --env-file=.env.local scripts/ui-login-cooldown.mjs",
    "test:ui:mobile": "node --env-file=.env.local scripts/ui-mobile.mjs",
    "test:publiq:policy": "tsx scripts/test-publiq-policy.ts",
    "test:ui:menu": "node scripts/ui-mobile-menu.mjs",
    "test:ui:seating": "node scripts/ui-seating-list.mjs",
    "test:ui:seat-photos": "node scripts/ui-seat-photos.mjs",
    "test:customer-auth": "tsx scripts/test-customer-auth.ts",
    "test:customer-auth:http": "node scripts/test-google-auth-http.mjs",
    "test:time-display": "tsx scripts/test-time-display.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.20.1",
    "next": "15.5.29",
    "nodemailer": "^10.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
