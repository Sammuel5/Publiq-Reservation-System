# =============================================================================
# KTV & Entertainment Club Reservation System — environment template
# Copy to .env.local (never commit real values). On Vercel, add these in
# Project → Settings → Environment Variables.
# =============================================================================

# ----------------------------------------------------------------------------
# MONGODB ATLAS  (required)
# Atlas → Database → Connect → "Drivers" → copy the SRV connection string.
# The user needs readWrite on the database; add the host's IP to the Atlas
# access list (or 0.0.0.0/0 for Vercel, whose egress IPs are dynamic).
# ----------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="ktv_club"

# ----------------------------------------------------------------------------
# ADMIN AUTHENTICATION  (required)
# Session lifetime in hours (rolling window is re-validated on every request).
# The cookie name is internal; change only if it collides with another app.
# ----------------------------------------------------------------------------
AUTH_SESSION_TTL_HOURS="8"
AUTH_COOKIE_NAME="ktv_admin_session"
# Leave unset in production (defaults to Secure when NODE_ENV=production).
# Set to "false" only when serving over plain HTTP outside Vercel.
# AUTH_COOKIE_SECURE="true"

# ----------------------------------------------------------------------------
# CLUB TIMEZONE  (required)
# All business hours, dates and pending-expiry rules use this timezone.
# ----------------------------------------------------------------------------
CLUB_TIMEZONE="Asia/Manila"

# ----------------------------------------------------------------------------
# SEED ONLY — used exclusively by `npm run seed:admin`, never by the app.
# Password policy: 12+ chars with upper, lower, digit and symbol.
# Delete these lines after the Super Admin exists, and rotate the password
# from the dashboard (Phase 3) or by re-running the seed with --force.
# ----------------------------------------------------------------------------
SEED_SUPER_ADMIN_NAME="Club Owner"
SEED_SUPER_ADMIN_EMAIL="owner@example.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe-Str0ng!Passphrase"

# ----------------------------------------------------------------------------
# PUBLIC (safe to expose to the browser)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Scheduler secret: 32+ random characters. Configure your scheduler to GET
# /api/cron/expire-holds with Authorization: Bearer <CRON_SECRET> every 5 minutes.
# Requires MongoDB replica set/Atlas transactions. Never expose this secret.
# CRON_SECRET="replace-with-at-least-32-random-characters"
# Run /api/cron/notifications on the same schedule and with the same Bearer secret.
# Email delivery uses Resend. SMS delivery uses Twilio. Leave unset to retain
# queued jobs without sending; configure a verified sender before enabling.
# RESEND_API_KEY=""
# NOTIFICATION_FROM_EMAIL="PUBLIQ <bookings@example.com>"
# NOTIFICATION_STAFF_EMAIL="reservations@example.com"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+15551234567"

# Customer Google sign-in (optional until configured; never share the secret).
# Register this exact callback as an Authorized redirect URI in Google Cloud.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/customer-auth/google/callback"
# CUSTOMER_SESSION_SECRET="generate-a-random-secret-at-least-32-characters"

# Experimental new seating flow. Keep disabled until all testing is complete.
# CUSTOMER_BOOKINGS_ENABLED="false"

# Optional: exact ngrok hostname for the Next.js development server only.
# No https://, port, slash, or wildcard; restart npm run dev after changing it.
# NEXT_DEV_ALLOWED_HOST="your-subdomain.ngrok-free.app"
